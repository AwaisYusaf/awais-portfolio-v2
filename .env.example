# Copy to .env.local and fill in (see README → Blog). .env.local is never committed.

# Contentful → Settings → API keys
CONTENTFUL_SPACE_ID=
# Content Delivery API token: published posts. Also set it on Vercel.
CONTENTFUL_DELIVERY_API_ACCESS_TOKEN=
# Content Preview API token (optional): shows drafts in `npm run dev`. Local only.
CONTENTFUL_PREVIEW_API_ACCESS_TOKEN=

# Contentful → Settings → CMA tokens. Only for `npm run contentful:setup`. Local only.
CONTENTFUL_MANAGEMENT_TOKEN=

# Optional: Vercel deploy hook. `npm run contentful:setup` then adds the
# Contentful webhook that rebuilds the site when you publish.
VERCEL_DEPLOY_HOOK_URL=

# Optional: another Contentful environment (default master).
# CONTENTFUL_ENVIRONMENT=master
